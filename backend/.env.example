# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ai-ebook-generator

# Server port
PORT=3000

# Secret used to sign/verify JWT tokens - use a long random string
JWT_SECRET_TOKEN=your_random_secret_key_here

# Google Gemini API key - get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
